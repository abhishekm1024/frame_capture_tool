# ============================================================================
# Release-signing configuration template.
#
# Copy this file to `keystore.properties` (at repo root) and fill in the four
# fields below. The real `keystore.properties` is gitignored — never commit it.
#
# Once present, `./gradlew assembleRelease` will produce a signed APK using the
# referenced keystore. When the file is absent, the release variant falls back
# to producing `app-release-unsigned.apk` so CI sanity-check builds still work.
#
# Path resolution: `storeFile` is resolved relative to the repo root. Keep the
# .jks file outside the repo (e.g. `~/.android/sfm-scanner-release.jks`) and
# use an absolute path here.
# ============================================================================

# Absolute or repo-root-relative path to the .jks / .keystore file.
storeFile=/absolute/path/to/sfm-scanner-release.jks

# Keystore password (the password you set when running keytool -genkey).
storePassword=REPLACE_ME

# Key alias inside the keystore.
keyAlias=sfm-scanner-release

# Password for the key alias above (often the same as storePassword).
keyPassword=REPLACE_ME
